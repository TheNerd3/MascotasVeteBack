# Copiar este archivo a ".env" y completar la contrasenia real.
# El archivo ".env" (sin ".example") nunca se sube al repositorio.

# Puerto donde escucha el SQL Server instalado en esta PC.
DB_PORT=1433

# Nombre de la base de datos creada con mascotas-cordoba-completo.sql.
DB_NAME=MascotasCordoba

# Usuario de SQL Server con permisos sobre la base MascotasCordoba.
DB_USER=sa

# Contrasenia de ese usuario. Completar con la contrasenia real, nunca
# dejarla vacia ni subirla a un repositorio.
DB_PASSWORD=

# Clave secreta con la que el backend firma el token de sesion (JWT).
# Tiene que tener al menos 32 caracteres. Generar una propia para cada
# entorno, nunca reusar la de otro proyecto.
JWT_SECRET=cambiar-esta-clave-por-una-propia-de-al-menos-32-caracteres

# Cuanto tiempo (en segundos) dura valido el token antes de que haya
# que volver a iniciar sesion. 28800 segundos = 8 horas.
JWT_EXPIRACION=28800

# Origen (protocolo + dominio + puerto) desde el que el frontend
# Angular puede llamar a este backend. En desarrollo, el servidor de
# Angular corre en el puerto 4200.
CORS_ORIGEN_PERMITIDO=http://localhost:4200
