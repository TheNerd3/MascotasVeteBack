{
  "info": {
    "name": "Mascotas Cordoba",
    "description": "Coleccion de pruebas end-to-end contra el backend de Mascotas Cordoba, usando datos-prueba.sql. Orden de ejecucion: RF15 -> RF17/18 -> RF06 -> RF09 -> RF10/11 -> RF13 -> RF20 -> RF21.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "RF15 - Login",
      "item": [
        {
          "name": "Login exitoso (ciudadano)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('devuelve token y perfil CIUDADANO', () => {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.perfil).to.eql('CIUDADANO');",
              "  pm.expect(body.idCiudadano).to.eql(25);",
              "});",
              "pm.environment.set('token', body.token);",
              "pm.environment.set('idCiudadano', body.idCiudadano);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"cuil\": \"20123456786\",\n  \"clave\": \"Prueba123!\"\n}" }
          }
        },
        {
          "name": "Login exitoso (refugio)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('perfil REFUGIO con idRefugio', () => {",
              "  pm.expect(body.perfil).to.eql('REFUGIO');",
              "  pm.expect(body.idRefugio).to.not.be.null;",
              "});",
              "pm.environment.set('tokenRefugio', body.token);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"cuil\": \"20345678906\",\n  \"clave\": \"Prueba123!\"\n}" }
          }
        },
        {
